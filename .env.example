DATABASE_URL=postgres://houttuynia:houttuynia@localhost:5432/houttuynia?sslmode=disable
SESSION_SECRET=dev-session-secret-change-me
HTTP_ADDR=:8080
COOKIE_SECURE=false

# local、qiniu 或 s3。没有密钥时 qiniu 和 s3 会拒绝签发上传凭证。
STORAGE_DRIVER=local
LOCAL_STORAGE_PATH=./data/uploads
# 留空时本地图片使用站内相对地址，方便和 Vite 代理一起用。
PUBLIC_BASE_URL=
WEB_DIR=

# 只在该邮箱的用户还不存在时写入。已存在的账号不会被重置密码。
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=admin123456

# QINIU_ACCESS_KEY=
# QINIU_SECRET_KEY=
# QINIU_BUCKET=
# QINIU_CDN_DOMAIN=

# S3_ENDPOINT=
# S3_REGION=
# S3_BUCKET=
